# Default environment compiled into U-Boot for the partitioned disk image.
#
# booti is given the control FDT (${fdtcontroladdr}) that OpenSBI passed to
# U-Boot, so the console order comes from rv-emu-rs-sv32.dtb or its --no-display
# variant. The root filesystem is partition 2; partition 1 is the ext2 boot
# partition holding Image.
kernel_addr_r=0x82000000
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
bootcmd=fdt addr ${fdtcontroladdr}; fdt get value bootargs /chosen bootargs; setenv bootargs ${bootargs} root=/dev/vda2 rootwait rw; virtio scan; ext2load virtio 0:1 ${kernel_addr_r} /Image; booti ${kernel_addr_r} - ${fdtcontroladdr}
