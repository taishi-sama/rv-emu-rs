# Build a 32-bit image.
#
# Copied from arch/riscv/configs/32-bit.config in the Linux tree: since 7.1
# there is no rv32_defconfig, 32-bit is a fragment on top of the generic
# defconfig. Keep this file in sync when bumping the kernel.
CONFIG_ARCH_RV32I=y
CONFIG_32BIT=y
# CONFIG_PORTABLE is not set
CONFIG_NONPORTABLE=y
